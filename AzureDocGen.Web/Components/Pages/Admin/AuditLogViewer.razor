@page "/Admin/AuditLogs"
@using AzureDocGen.Data.Entities
@using AzureDocGen.Web.Services
@using Microsoft.AspNetCore.Authorization
@inject IAuditLogService AuditLogService
@attribute [Authorize(Policy = "RequireSystemAdministrator")]
@rendermode InteractiveServer

<PageTitle>監査ログ</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-file-text"></i> 監査ログ</h2>
    <div>
        <button class="btn btn-outline-primary" @onclick="LoadLogs">
            <i class="bi bi-arrow-clockwise"></i> 更新
        </button>
        <button class="btn btn-outline-secondary" @onclick="ToggleFilters">
            <i class="bi bi-funnel"></i> フィルター
        </button>
    </div>
</div>

<!-- フィルター -->
@if (showFilters)
{
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">ユーザー</label>
                    <input type="text" class="form-control" @bind="filterUserId" placeholder="ユーザーID" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">アクション</label>
                    <select class="form-select" @bind="filterAction">
                        <option value="">すべて</option>
                        <option value="Create">作成</option>
                        <option value="Update">更新</option>
                        <option value="Delete">削除</option>
                        <option value="Login">ログイン</option>
                        <option value="Logout">ログアウト</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">エンティティタイプ</label>
                    <select class="form-select" @bind="filterEntityType">
                        <option value="">すべて</option>
                        <option value="Project">プロジェクト</option>
                        <option value="Environment">環境</option>
                        <option value="Template">テンプレート</option>
                        <option value="Resource">リソース</option>
                        <option value="User">ユーザー</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">日付範囲</label>
                    <select class="form-select" @bind="dateRange" @bind:after="ApplyDateRange">
                        <option value="today">今日</option>
                        <option value="week">過去7日間</option>
                        <option value="month">過去30日間</option>
                        <option value="all">すべて</option>
                    </select>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-12">
                    <button class="btn btn-primary me-2" @onclick="ApplyFilters">
                        <i class="bi bi-search"></i> 検索
                    </button>
                    <button class="btn btn-secondary" @onclick="ClearFilters">
                        <i class="bi bi-x-circle"></i> クリア
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- 統計 -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h3 class="text-primary">@totalLogs</h3>
                <small class="text-muted">総ログ数</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h3 class="text-success">@statistics.ActionCounts.GetValueOrDefault("Create", 0)</h3>
                <small class="text-muted">作成</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h3 class="text-info">@statistics.ActionCounts.GetValueOrDefault("Update", 0)</h3>
                <small class="text-muted">更新</small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h3 class="text-danger">@statistics.ActionCounts.GetValueOrDefault("Delete", 0)</h3>
                <small class="text-muted">削除</small>
            </div>
        </div>
    </div>
</div>

<!-- ログ一覧 -->
<div class="card">
    <div class="card-header">
        <h5 class="mb-0">ログ一覧</h5>
    </div>
    <div class="card-body">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">読み込み中...</span>
                </div>
            </div>
        }
        else if (!auditLogs.Any())
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mt-2">ログがありません。</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>日時</th>
                            <th>ユーザー</th>
                            <th>アクション</th>
                            <th>エンティティ</th>
                            <th>詳細</th>
                            <th>IPアドレス</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in auditLogs)
                        {
                            <tr>
                                <td>@log.Timestamp.ToLocalTime().ToString("yyyy/MM/dd HH:mm:ss")</td>
                                <td>
                                    <i class="bi bi-person"></i>
                                    @(log.User?.UserName ?? log.UserId)
                                </td>
                                <td>
                                    @GetActionBadge(log.Action)
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@log.EntityType</span>
                                    @if (log.EntityId.HasValue)
                                    {
                                        <br />
                                        <small class="text-muted">@log.EntityId.Value.ToString().Substring(0, 8)...</small>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(log.Details))
                                    {
                                        if (log.Details.Length > 50)
                                        {
                                            <span title="@log.Details">
                                                @log.Details.Substring(0, 50)...
                                            </span>
                                        }
                                        else
                                        {
                                            @log.Details
                                        }
                                    }
                                </td>
                                <td>
                                    <small class="text-muted">@log.IpAddress</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- ページネーション -->
            @if (totalPages > 1)
            {
                <nav aria-label="ページネーション" class="mt-3">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(1)" disabled="@(currentPage == 1)">
                                <i class="bi bi-chevron-bar-left"></i>
                            </button>
                        </li>
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(currentPage - 1)" disabled="@(currentPage == 1)">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                        </li>

                        @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                        {
                            var page = i;
                            <li class="page-item @(currentPage == page ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(page)">@page</button>
                            </li>
                        }

                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(currentPage + 1)" disabled="@(currentPage == totalPages)">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </li>
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(totalPages)" disabled="@(currentPage == totalPages)">
                                <i class="bi bi-chevron-bar-right"></i>
                            </button>
                        </li>
                    </ul>
                    <p class="text-center text-muted">
                        ページ @currentPage / @totalPages （全 @totalLogs 件）
                    </p>
                </nav>
            }
        }
    </div>
</div>

@code {
    private bool isLoading = true;
    private bool showFilters = false;
    private List<AuditLog> auditLogs = new();
    private AuditLogStatistics statistics = new();
    private int currentPage = 1;
    private int pageSize = 50;
    private int totalLogs = 0;
    private int totalPages = 0;

    // フィルター
    private string? filterUserId;
    private string? filterAction;
    private string? filterEntityType;
    private DateTime? fromDate;
    private DateTime? toDate;
    private string dateRange = "week";

    protected override async Task OnInitializedAsync()
    {
        ApplyDateRange();
        await LoadLogs();
        await LoadStatistics();
    }

    private async Task LoadLogs()
    {
        isLoading = true;

        try
        {
            var (logs, count) = await AuditLogService.GetAuditLogsAsync(
                filterUserId,
                filterAction,
                filterEntityType,
                fromDate,
                toDate,
                currentPage,
                pageSize
            );

            auditLogs = logs;
            totalLogs = count;
            totalPages = (int)Math.Ceiling(totalLogs / (double)pageSize);
        }
        catch (Exception)
        {
            // エラーハンドリング
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadStatistics()
    {
        statistics = await AuditLogService.GetAuditLogStatisticsAsync(fromDate, toDate);
    }

    private void ToggleFilters()
    {
        showFilters = !showFilters;
    }

    private async Task ApplyFilters()
    {
        currentPage = 1;
        await LoadLogs();
        await LoadStatistics();
    }

    private async Task ClearFilters()
    {
        filterUserId = null;
        filterAction = null;
        filterEntityType = null;
        dateRange = "week";
        ApplyDateRange();
        currentPage = 1;
        await LoadLogs();
        await LoadStatistics();
    }

    private void ApplyDateRange()
    {
        switch (dateRange)
        {
            case "today":
                fromDate = DateTime.Today;
                toDate = DateTime.Now;
                break;
            case "week":
                fromDate = DateTime.Now.AddDays(-7);
                toDate = DateTime.Now;
                break;
            case "month":
                fromDate = DateTime.Now.AddDays(-30);
                toDate = DateTime.Now;
                break;
            case "all":
                fromDate = null;
                toDate = null;
                break;
        }
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        await LoadLogs();
    }

    private RenderFragment GetActionBadge(string action)
    {
        return action switch
        {
            "Create" => @<span class="badge bg-success">作成</span>,
            "Update" => @<span class="badge bg-info">更新</span>,
            "Delete" => @<span class="badge bg-danger">削除</span>,
            "Login" => @<span class="badge bg-primary">ログイン</span>,
            "Logout" => @<span class="badge bg-secondary">ログアウト</span>,
            _ => @<span class="badge bg-secondary">@action</span>
        };
    }
}
