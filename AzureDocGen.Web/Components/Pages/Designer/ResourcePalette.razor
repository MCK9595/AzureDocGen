@using AzureDocGen.Web.Models

<div class="resource-palette">
    <div class="palette-header p-3 border-bottom">
        <h6 class="mb-2"><i class="bi bi-grid-3x3-gap"></i> リソースパレット</h6>
        <input type="text" class="form-control form-control-sm"
               placeholder="リソース検索..."
               @bind="searchTerm"
               @bind:event="oninput" />
    </div>

    <div class="palette-content p-2">
        @foreach (var category in GetGroupedResources())
        {
            <div class="palette-category mb-3">
                <div class="category-header d-flex justify-content-between align-items-center p-2 bg-light rounded"
                     @onclick="() => ToggleCategory(category.Key)"
                     style="cursor: pointer;">
                    <strong>
                        <i class="bi @(expandedCategories.Contains(category.Key) ? "bi-chevron-down" : "bi-chevron-right")"></i>
                        @category.Key
                    </strong>
                    <span class="badge bg-secondary">@category.Value.Count</span>
                </div>

                @if (expandedCategories.Contains(category.Key))
                {
                    <div class="category-items mt-2">
                        @foreach (var resourceType in category.Value)
                        {
                            <div class="resource-item p-2 mb-1 border rounded"
                                 draggable="true"
                                 @onclick="() => SelectResource(resourceType.Type)"
                                 style="cursor: pointer;">
                                <div class="d-flex align-items-center">
                                    <span class="resource-icon me-2">@resourceType.Icon</span>
                                    <div class="flex-grow-1">
                                        <div class="resource-name">@resourceType.DisplayName</div>
                                        @if (!string.IsNullOrEmpty(resourceType.Description))
                                        {
                                            <small class="text-muted">@resourceType.Description</small>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (!GetGroupedResources().Any())
        {
            <div class="text-center text-muted p-3">
                <i class="bi bi-search"></i>
                <p class="mb-0">該当するリソースがありません</p>
            </div>
        }
    </div>

    <div class="palette-footer p-2 border-top">
        <small class="text-muted">
            <i class="bi bi-info-circle"></i>
            クリックまたはドラッグしてキャンバスに追加
        </small>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback<string> OnResourceSelected { get; set; }

    private string searchTerm = "";
    private HashSet<string> expandedCategories = new() { "コンピューティング", "ストレージ", "ネットワーク" };

    private Dictionary<string, List<ResourceTypeInfo>> GetGroupedResources()
    {
        var filtered = AzureResourceTypes.AllTypes
            .Where(r => string.IsNullOrEmpty(searchTerm) ||
                       r.DisplayName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                       r.Type.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                       r.Category.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))
            .ToList();

        return filtered
            .GroupBy(r => r.Category)
            .OrderBy(g => g.Key)
            .ToDictionary(g => g.Key, g => g.OrderBy(r => r.DisplayName).ToList());
    }

    private void ToggleCategory(string category)
    {
        if (expandedCategories.Contains(category))
        {
            expandedCategories.Remove(category);
        }
        else
        {
            expandedCategories.Add(category);
        }
    }

    private async Task SelectResource(string resourceType)
    {
        await OnResourceSelected.InvokeAsync(resourceType);
    }
}

<style>
    .resource-palette {
        height: 100%;
        display: flex;
        flex-direction: column;
        background: white;
    }

    .palette-header {
        flex-shrink: 0;
    }

    .palette-content {
        flex: 1;
        overflow-y: auto;
    }

    .palette-footer {
        flex-shrink: 0;
        background: #f8f9fa;
    }

    .resource-item {
        transition: all 0.2s ease;
        background: white;
    }

    .resource-item:hover {
        background: #e7f3ff;
        border-color: #0d6efd !important;
        transform: translateX(4px);
    }

    .resource-icon {
        font-size: 1.5rem;
        line-height: 1;
    }

    .resource-name {
        font-weight: 500;
        font-size: 0.875rem;
    }

    .category-header:hover {
        background: #e9ecef !important;
    }

    .palette-content::-webkit-scrollbar {
        width: 8px;
    }

    .palette-content::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    .palette-content::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 4px;
    }

    .palette-content::-webkit-scrollbar-thumb:hover {
        background: #555;
    }
</style>
